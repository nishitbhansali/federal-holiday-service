{
	"info": {
		"_postman_id": "federal-holidays-api",
		"name": "Federal Holidays API",
		"description": "Complete API collection for Federal Holidays Service (USA and Canada)",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{token}}",
				"type": "string"
			}
		]
	},
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					""
				]
			}
		},
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					""
				]
			}
		}
	],
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8080/federal-holidays-api",
			"type": "string"
		},
		{
			"key": "token",
			"value": "",
			"type": "string"
		},
		{
			"key": "correlationId",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "1. Generate JWT Token",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"// Auto-save token and correlationId to collection variables",
							"if (pm.response.code === 200) {",
							"    const response = pm.response.json();",
							"    pm.collectionVariables.set('token', response.token);",
							"    pm.collectionVariables.set('correlationId', response.correlationId);",
							"    console.log('Token saved:', response.token.substring(0, 20) + '...');",
							"    console.log('Correlation ID saved:', response.correlationId);",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"auth": {
					"type": "noauth"
				},
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/api/v1/test/generate-token?userId=test-user",
					"host": ["{{baseUrl}}"],
					"path": ["api", "v1", "test", "generate-token"],
					"query": [
						{
							"key": "userId",
							"value": "test-user",
							"description": "User ID to embed in token"
						}
					]
				},
				"description": "Generate a JWT token for testing (local profile only). Token and correlationId are auto-saved to collection variables."
			},
			"response": []
		},
		{
			"name": "2. Health Check",
			"request": {
				"auth": {
					"type": "noauth"
				},
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/actuator/health",
					"host": ["{{baseUrl}}"],
					"path": ["actuator", "health"]
				},
				"description": "Health check endpoint (no authentication required)"
			},
			"response": []
		},
		{
			"name": "3. Create Holiday",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "X-Correlation-ID",
						"value": "{{correlationId}}",
						"type": "text"
					},
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"holidayName\": \"Remembrance Day\",\n  \"holidayDate\": \"2026-11-11\",\n  \"country\": \"CANADA\",\n  \"isRecurring\": true,\n  \"description\": \"Commemorates the end of World War I and honors veterans\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/v1/holidays",
					"host": ["{{baseUrl}}"],
					"path": ["api", "v1", "holidays"]
				},
				"description": "Create a new federal holiday. Returns 201 on success."
			},
			"response": []
		},
		{
			"name": "4. Get All Holidays",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "X-Correlation-ID",
						"value": "{{correlationId}}",
						"type": "text"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/api/v1/holidays",
					"host": ["{{baseUrl}}"],
					"path": ["api", "v1", "holidays"]
				},
				"description": "Retrieve all federal holidays (USA and Canada)"
			},
			"response": []
		},
		{
			"name": "5. Get Holiday by ID",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "X-Correlation-ID",
						"value": "{{correlationId}}",
						"type": "text"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/api/v1/holidays/1",
					"host": ["{{baseUrl}}"],
					"path": ["api", "v1", "holidays", "1"]
				},
				"description": "Retrieve a specific holiday by ID"
			},
			"response": []
		},
		{
			"name": "6. Get Holidays by Country",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "X-Correlation-ID",
						"value": "{{correlationId}}",
						"type": "text"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/api/v1/holidays/country/USA",
					"host": ["{{baseUrl}}"],
					"path": ["api", "v1", "holidays", "country", "USA"]
				},
				"description": "Retrieve all holidays for a specific country (USA or CANADA)"
			},
			"response": []
		},
		{
			"name": "7. Search Holidays by Year",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "X-Correlation-ID",
						"value": "{{correlationId}}",
						"type": "text"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/api/v1/holidays/search?country=USA&year=2026",
					"host": ["{{baseUrl}}"],
					"path": ["api", "v1", "holidays", "search"],
					"query": [
						{
							"key": "country",
							"value": "USA"
						},
						{
							"key": "year",
							"value": "2026"
						}
					]
				},
				"description": "Search holidays by country and/or year"
			},
			"response": []
		},
		{
			"name": "8. Search Holidays by Date Range",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "X-Correlation-ID",
						"value": "{{correlationId}}",
						"type": "text"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/api/v1/holidays/search?startDate=2026-07-01&endDate=2026-12-31",
					"host": ["{{baseUrl}}"],
					"path": ["api", "v1", "holidays", "search"],
					"query": [
						{
							"key": "startDate",
							"value": "2026-07-01"
						},
						{
							"key": "endDate",
							"value": "2026-12-31"
						}
					]
				},
				"description": "Search holidays within a date range"
			},
			"response": []
		},
		{
			"name": "9. Update Holiday",
			"request": {
				"method": "PUT",
				"header": [
					{
						"key": "X-Correlation-ID",
						"value": "{{correlationId}}",
						"type": "text"
					},
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"holidayName\": \"Independence Day (Updated)\",\n  \"holidayDate\": \"2026-07-04\",\n  \"country\": \"USA\",\n  \"isRecurring\": true,\n  \"description\": \"Celebrates the adoption of the Declaration of Independence on July 4, 1776\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/v1/holidays/1",
					"host": ["{{baseUrl}}"],
					"path": ["api", "v1", "holidays", "1"]
				},
				"description": "Update an existing holiday by ID"
			},
			"response": []
		},
		{
			"name": "10. Delete Holiday",
			"request": {
				"method": "DELETE",
				"header": [
					{
						"key": "X-Correlation-ID",
						"value": "{{correlationId}}",
						"type": "text"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/api/v1/holidays/11",
					"host": ["{{baseUrl}}"],
					"path": ["api", "v1", "holidays", "11"]
				},
				"description": "Delete a holiday by ID (returns 204 No Content)"
			},
			"response": []
		}
	]
}
